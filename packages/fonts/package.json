{
  "name": "@sigilora/fonts",
  "version": "0.0.0",
  "description": "Color symbol fonts for game text via OpenType ligatures and COLR/CPAL.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunchy321/sigilora"
  },
  "license": "CC-BY-NC-4.0",
  "files": [
    "magic",
    "lorcana"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./magic.css": "./magic/magic.css",
    "./magic/*": "./magic/*",
    "./lorcana.css": "./lorcana/lorcana.css",
    "./lorcana/*": "./lorcana/*"
  },
  "keywords": [
    "fonts",
    "opentype",
    "ligatures",
    "colr",
    "cpal",
    "color-fonts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
